rules_version = '2';
// Reglas de seguridad de Firestore para la web de Novaskil FC.
// Copiar y pegar en Firebase > Firestore Database > Reglas > Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function hasProfile() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isAdmin() { return hasProfile() && profile().role == 'admin' && profile().status == 'approved'; }
    function isManager() { return hasProfile() && profile().role == 'manager' && profile().status == 'approved'; }

    // Contenido de la web: lo lee cualquiera.
    // Administración puede cambiarlo todo; managers solo fichajes y plantilla.
    match /site/state {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isManager() && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['f_moves', 'f_squad', 'revs', 'by', 'at']));
    }

    // Usuarios
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // Al registrarse: fan aprobado directamente; jugador y manager quedan pendientes.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'status', 'created'])
        && ((request.resource.data.role == 'fan' && request.resource.data.status == 'approved')
            || (request.resource.data.role in ['player', 'manager'] && request.resource.data.status == 'pending'));
      // Cada usuario puede cambiar su nombre; el rol y el estado solo los cambia administración.
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']));
      allow delete: if isAdmin();
    }
  }
}
